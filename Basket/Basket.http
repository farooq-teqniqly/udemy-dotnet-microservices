@Basket_HostAddress = https://localhost:7160
@Keycloak_HostAddress = http://localhost:50787
@username = farooq

POST {{Basket_HostAddress}}/basket
Content-Type: application/json
Accept: application/json
{
  "username": "{{username}}",
  "items": [
    {
      "price": 999.99,
      "quantity": 1
    },
    {
      "price": 49.99,
      "quantity": 2
    },
    {
      "price": 199.99,
      "quantity": 1
    }
  ]
}

###

GET {{Basket_HostAddress}}/basket/{{username}}
Accept: application/json

###

PUT {{Basket_HostAddress}}/basket
Content-Type: application/json
Accept: application/json
{
  "username": "{{username}}",
  "items": [
    {
      "price": 999.99,
      "quantity": 2
    },
    {
      "price": 49.99,
      "quantity": 4
    },
    {
      "price": 199.99,
      "quantity": 2
    }
  ]
}

###

DELETE {{Basket_HostAddress}}/basket/{{username}}
Accept: application/json
###
POST {{Keycloak_HostAddress}}/realms/eshop/protocol/openid-connect/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&client_id=eshop-client&scope=email openid&username=test&password=1234
